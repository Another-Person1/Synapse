# networkd uses the first matching .network file across all directories, in
# name order. 05- sorts before netplan's generated 10-netplan-*.network, whose
# usb* match would otherwise make the gadget a DHCP client. Only the gadget
# configuration the host activates has carrier, so only that one is configured.
[Match]
Driver=g_ether

[Link]
RequiredForOnline=no

[Network]
Address=10.12.194.1/28
DHCPServer=yes
LinkLocalAddressing=ipv6
IPv6AcceptRA=no
IPForward=no

[DHCPServer]
PoolOffset=2
PoolSize=12
EmitDNS=no
EmitRouter=no
